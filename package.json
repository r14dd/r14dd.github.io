{
  "name": "riad-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "astro dev",
    "prebuild": "node scripts/build-resume.mjs && node scripts/build-og.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-claims.mjs",
    "preview": "astro preview",
    "lint": "eslint . && node scripts/check-no-emdash.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "check": "astro check",
    "check:workers": "node scripts/check-workers.mjs",
    "check:links": "node scripts/check-links.mjs",
    "sync:linkedin": "node scripts/sync-linkedin.mjs",
    "test:e2e": "playwright test",
    "check:emdash": "node scripts/check-no-emdash.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
