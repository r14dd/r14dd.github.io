---
// Private calorie/protein tracker: riad.cc/food (noindex, excluded from sitemap).
// Standalone like /admin: no BaseLayout, forced dark theme, no Web Analytics
// beacon. Everything lives in localStorage. Nothing is fetched on load; USDA
// (generic foods) and Open Food Facts (barcodes) are only called on a search,
// straight from the browser. The USDA key is asked for once and kept locally.
// Every string from USDA, Open Food Facts or storage is rendered with
// textContent, never innerHTML: this origin also holds the admin keys.
---

<!doctype html>
<html lang="en" translate="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#050505" />
    <title>Food: riad.cc</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

    <style is:global>
      @font-face {
        font-family: 'Manrope';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url(/fonts/manrope-latin.woff2) format('woff2');
      }
      @font-face {
        font-family: 'Cormorant Garamond';
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url(/fonts/font-5.woff2) format('woff2');
      }
      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url(/fonts/font-11.woff2) format('woff2');
      }

      :root {
        color-scheme: dark;
        --bg: #050505;
        --fg: #eeeeee;
        --soft: #a1a1a1;
        --mut: #888888;
        --line: rgba(255, 255, 255, 0.08);
        --card: rgba(12, 12, 12, 0.9);
        --acc: #c9a55a;
        --acc-bg: rgba(201, 165, 90, 0.1);
        --ok: #4ade80;
        --mono: 'JetBrains Mono', ui-monospace, monospace;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font:
          16px/1.5 'Manrope',
          system-ui,
          sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      main.shell {
        max-width: 600px;
        margin: 0 auto;
        padding: 28px 16px 72px;
      }
      .eyebrow {
        font: 12px/1 var(--mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--acc);
        margin: 0 0 10px;
      }
      h1 {
        font:
          600 44px/1 'Cormorant Garamond',
          Georgia,
          serif;
        margin: 0 0 20px;
      }
      h1 small {
        font: 400 13px var(--mono);
        letter-spacing: 0.1em;
        color: var(--mut);
        margin-left: 10px;
        vertical-align: middle;
      }
      h2 {
        font: 12px/1 var(--mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--acc);
        margin: 0 0 6px;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 18px;
        margin: 0 0 16px;
      }
      .hint {
        color: var(--mut);
        font-size: 14px;
        margin: 0 0 12px;
      }
      .bar {
        margin: 0 0 14px;
      }
      .bar:last-child {
        margin: 0;
      }
      .bar .t {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 6px;
      }
      .bar .t b {
        font-weight: 600;
      }
      .bar .t span {
        color: var(--soft);
        font-size: 14px;
      }
      .bar .b {
        height: 10px;
        background: rgba(255, 255, 255, 0.07);
        border-radius: 5px;
        overflow: hidden;
      }
      .bar .b i {
        display: block;
        height: 100%;
        background: var(--acc);
        border-radius: 5px;
        transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .bar.done .b i {
        background: var(--ok);
      }
      .bar.done .t span {
        color: var(--ok);
      }
      .row {
        display: flex;
        gap: 8px;
        margin: 8px 0 0;
      }
      input,
      button {
        font: inherit;
        font-size: 16px;
        min-height: 46px;
        padding: 0 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--fg);
        min-width: 0;
      }
      input {
        flex: 1;
      }
      input::placeholder {
        color: var(--mut);
      }
      input.n {
        flex: 0 0 90px;
      }
      button {
        cursor: pointer;
        transition:
          background 0.15s,
          border-color 0.15s,
          transform 0.15s;
      }
      button:hover {
        border-color: rgba(201, 165, 90, 0.5);
      }
      button:active {
        transform: scale(0.97);
      }
      :focus-visible {
        outline: 2px solid var(--acc);
        outline-offset: 2px;
      }
      input:focus {
        border-color: var(--acc);
        outline: none;
      }
      button.go {
        background: var(--acc);
        color: #1a1306;
        border: 0;
        font-weight: 700;
      }
      button.go:hover {
        background: #d8b668;
      }
      button.ai {
        background: var(--acc-bg);
        border-color: rgba(201, 165, 90, 0.35);
        color: var(--acc);
        font-weight: 600;
      }
      button.x {
        background: none;
        border: 0;
        color: var(--mut);
        min-height: 36px;
        padding: 0 10px;
        font-size: 20px;
      }
      button.x:hover {
        color: #ff6b6b;
      }
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 10px 0 0;
      }
      .chips button {
        min-height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        font: 13px var(--mono);
        color: var(--soft);
      }
      ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      li {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 11px 0;
        border-bottom: 1px solid var(--line);
      }
      li:last-child {
        border-bottom: 0;
      }
      li small {
        color: var(--mut);
        font: 12px var(--mono);
        text-align: right;
        white-space: nowrap;
      }
      #results {
        margin-top: 6px;
      }
      #results li {
        padding: 0;
      }
      li button.pick {
        flex: 1;
        text-align: left;
        background: none;
        border: 0;
        border-radius: 8px;
        padding: 12px 0;
        color: var(--fg);
        min-height: 48px;
      }
      li button.pick:hover {
        color: var(--acc);
      }
      #recs li {
        cursor: pointer;
      }
      #recs li:hover b {
        text-decoration: underline;
      }
      .msg {
        color: var(--soft);
        font-size: 14px;
        margin: 10px 0 0;
        min-height: 1.3em;
      }
      .picked {
        display: none;
        border: 1px solid rgba(201, 165, 90, 0.35);
        background: var(--acc-bg);
        border-radius: 14px;
        padding: 14px;
        margin: 14px 0 0;
      }
      .picked.on {
        display: block;
      }
      .picked p {
        margin: 0;
        font-weight: 600;
      }
      .empty {
        color: var(--mut);
        font-size: 14px;
        margin: 0;
        padding: 4px 0;
      }
      .rec b {
        color: var(--acc);
        font-weight: 600;
      }
      details summary {
        cursor: pointer;
        list-style: none;
        font: 12px/1 var(--mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--acc);
        padding: 4px 0;
      }
      details summary::-webkit-details-marker {
        display: none;
      }
      details summary::after {
        content: ' +';
      }
      details[open] summary::after {
        content: ' \2212';
      }
      label.l {
        display: block;
        color: var(--soft);
        font-size: 13px;
        margin: 14px 0 0;
      }
      a {
        color: var(--acc);
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell" id="food">
      <p class="eyebrow">/food · private</p>
      <h1>Today <small id="date"></small></h1>
      <section class="card" id="bars"></section>

      <section class="card">
        <h2>Add food</h2>
        <p class="hint">
          Type a food and press Search. Paste a barcode for packaged food. Or describe a meal in
          words and tap AI estimate.
        </p>
        <div class="row">
          <input
            id="q"
            placeholder="e.g. chicken breast, or two eggs"
            autocomplete="off"
            aria-label="Search"
          />
        </div>
        <div class="row">
          <button id="search" class="go" style="flex: 1">Search</button>
          <button
            id="ai"
            class="ai"
            style="flex: 1"
            title="Estimate calories and protein from your words">AI estimate</button
          >
        </div>
        <div id="msg" class="msg" role="status"></div>
        <ul id="results"></ul>
        <div id="pickbox" class="picked">
          <p id="picked"></p>
          <div class="chips" id="quick"></div>
          <div class="row">
            <input
              id="grams"
              class="n"
              type="number"
              inputmode="decimal"
              placeholder="grams"
              aria-label="Grams"
            />
            <button id="add" class="go" style="flex: 1">Add to today</button>
          </div>
        </div>
      </section>

      <section class="card">
        <h2>Ideas to hit your protein</h2>
        <p class="hint">Tap one to fill in the amount.</p>
        <div id="recs" class="rec"></div>
      </section>

      <section class="card">
        <h2>Today's log</h2>
        <ul id="log"></ul>
        <p id="logempty" class="empty">Nothing logged yet. Add your first food above.</p>
      </section>

      <section class="card">
        <h2>Add by numbers</h2>
        <p class="hint">For food you can't look up, like a home-cooked dinner.</p>
        <div class="row">
          <input id="cname" placeholder="name (e.g. family dinner)" aria-label="Name" />
        </div>
        <div class="row">
          <input
            id="ckcal"
            class="n"
            style="flex: 1"
            type="number"
            inputmode="numeric"
            placeholder="calories"
            aria-label="kcal"
          />
          <input
            id="cprot"
            class="n"
            style="flex: 1"
            type="number"
            inputmode="numeric"
            placeholder="protein (g)"
            aria-label="Protein"
          />
          <button id="cadd" class="go" aria-label="Add">Add</button>
        </div>
      </section>

      <section class="card">
        <details id="settings">
          <summary>Settings &amp; backup</summary>
          <label class="l" for="ukey"
            >USDA key: needed to search generic foods. Free at&nbsp;
            <a href="https://api.data.gov/signup/" target="_blank" rel="noopener noreferrer"
              >api.data.gov/signup</a
            ></label
          >
          <div class="row">
            <input
              id="ukey"
              placeholder="paste USDA key"
              autocomplete="off"
              aria-label="USDA key"
            />
          </div>
          <label class="l" for="tkey">AI token: needed for the AI estimate button</label>
          <div class="row">
            <input
              id="tkey"
              type="password"
              placeholder="paste AI token"
              autocomplete="off"
              aria-label="AI token"
            />
          </div>
          <div class="row">
            <button id="ksave" class="go" style="flex: 1">Save keys</button>
          </div>
          <label class="l">Backup: save your history to a file, or load it back</label>
          <div class="row">
            <button id="export" style="flex: 1">Export</button>
            <button id="import" style="flex: 1">Import</button>
            <input id="file" type="file" accept="application/json" hidden />
          </div>
        </details>
      </section>
    </main>

    <script is:inline>
      (() => {
        const $ = (id) => document.getElementById(id);
        const T = { kcal: 2400, prot: 190 };

        // v = [kcal, protein, carbs, fat] per 100 g. rec = lean protein source.
        const SEEDS = [
          { name: 'süzmə (cottage cheese)', v: [110, 12.5, 3, 5] },
          { name: 'egg', v: [143, 12.6, 0.7, 9.5], unit: 50, unitName: 'egg' },
          { name: 'hinduşka (turkey, cooked)', v: [150, 29, 0, 3] },
          { name: 'hinduşka kotleti', v: [180, 22, 6, 8] },
          { name: 'beef (cooked)', v: [250, 26, 0, 15] },
          { name: 'qatıq (plain)', v: [60, 6, 4.5, 2.5] },
          { name: 'milk', v: [60, 3.5, 5, 3] },
          { name: 'lobya / noxud (cooked)', v: [140, 8, 22, 2] },
          { name: 'yarpaq dolması', v: [160, 7, 15, 8] },
          { name: 'whey', v: [400, 80, 10, 5], unit: 30, unitName: 'scoop' },
          { name: 'qarabaşaq (cooked)', v: [110, 4, 21, 1] },
          { name: 'rice (cooked)', v: [130, 2.7, 28, 0.3] },
          { name: 'pasta (cooked)', v: [158, 6, 31, 1] },
          { name: 'potato (boiled)', v: [87, 2, 20, 0.1] },
          { name: 'bread', v: [265, 9, 49, 3] },
          { name: 'nuts', v: [600, 18, 20, 52] },
          { name: 'salad (raw veg)', v: [16, 1, 3, 0] },
        ];
        // Off the suggestion list (retired or not eaten); still searchable and loggable.
        const NOT_SUGGESTED = /chicken|shawarma|lamb|mutton|fish|salmon|tuna|cod\b|liver|mushroom/i;

        const today = new Date().toLocaleDateString('sv');
        const LOG = 'food-log-' + today;
        const CACHE = 'food-cache';
        const KEY = 'food-usda-key';
        const TOKEN = 'food-ai-token';
        const API = 'https://food-api.riad-mrv.workers.dev';

        const read = (k, fb) => {
          try {
            const raw = localStorage.getItem(k);
            return raw === null ? fb : JSON.parse(raw);
          } catch {
            return fb;
          }
        };
        const write = (k, val) => {
          try {
            localStorage.setItem(k, JSON.stringify(val));
          } catch {
            say('Could not save (storage full or blocked).');
          }
        };

        const num = (x, max) => Number.isFinite(x) && x >= 0 && x <= max;
        const validFood = (f) =>
          f &&
          typeof f.name === 'string' &&
          f.name.length > 0 &&
          f.name.length <= 80 &&
          Array.isArray(f.v) &&
          f.v.length === 4 &&
          f.v.every((x) => num(x, 5000));
        const validEntry = (e) =>
          e &&
          typeof e.name === 'string' &&
          e.name.length <= 80 &&
          [e.kcal, e.prot, e.carb, e.fat].every((x) => num(x, 20000)) &&
          (e.g === undefined || num(e.g, 5000));

        const getCache = () => {
          const c = read(CACHE, []);
          return Array.isArray(c) ? c.filter(validFood) : [];
        };
        const getLog = () => {
          const l = read(LOG, []);
          return Array.isArray(l) ? l.filter(validEntry) : [];
        };
        const allFoods = () => {
          const seen = new Set();
          return [...SEEDS, ...getCache()].filter((f) => {
            const k = f.name.toLowerCase();
            if (seen.has(k)) return false;
            seen.add(k);
            return true;
          });
        };

        const el = (tag, text, cls) => {
          const n = document.createElement(tag);
          if (text !== undefined) n.textContent = text;
          if (cls) n.className = cls;
          return n;
        };
        const say = (t) => ($('msg').textContent = t);
        const r = (x) => Math.round(x);

        let picked = null;

        // ---- lookups -------------------------------------------------------
        const fromUsda = (f) => {
          const get = (id) => (f.foodNutrients || []).find((n) => n.nutrientId === id)?.value;
          const kcal = get(1008) ?? get(2047) ?? get(2048);
          const p = get(1003);
          if (kcal === undefined || p === undefined) return null;
          return {
            name: String(f.description || '').slice(0, 80),
            v: [kcal, p, get(1005) ?? 0, get(1004) ?? 0],
          };
        };

        async function searchUsda(q) {
          const key = read(KEY, '');
          if (!key) return say('Add a USDA key in Settings to search generic foods.');
          say('Searching USDA...');
          const url =
            'https://api.nal.usda.gov/fdc/v1/foods/search?pageSize=10' +
            '&dataType=Foundation,SR%20Legacy&query=' +
            encodeURIComponent(q) +
            '&api_key=' +
            encodeURIComponent(key);
          const res = await fetch(url);
          if (!res.ok) return say('USDA error ' + res.status + '.');
          const data = await res.json();
          const foods = (data.foods || []).map(fromUsda).filter(validFood);
          say(foods.length ? '' : 'Nothing found on USDA.');
          showResults(foods, true);
        }

        async function lookupBarcode(code) {
          say('Looking up barcode...');
          const res = await fetch(
            'https://world.openfoodfacts.org/api/v2/product/' + code + '.json',
          );
          const data = res.ok ? await res.json() : null;
          const n = data?.product?.nutriments;
          if (!n || n['energy-kcal_100g'] === undefined || n.proteins_100g === undefined) {
            return say('Barcode not found, or it has no nutrition data.');
          }
          const p = data.product;
          const name = [p.brands, p.product_name].filter(Boolean).join(' ').slice(0, 80) || code;
          const food = {
            name,
            v: [
              Number(n['energy-kcal_100g']),
              Number(n.proteins_100g),
              Number(n.carbohydrates_100g) || 0,
              Number(n.fat_100g) || 0,
            ],
          };
          if (!validFood(food)) return say('That product has bad nutrition data.');
          say('');
          showResults([food], true);
        }

        function showResults(foods, remote) {
          const ul = $('results');
          ul.replaceChildren();
          for (const f of foods.slice(0, 10)) {
            const li = el('li');
            const b = el('button', f.name, 'pick');
            b.type = 'button';
            b.onclick = () => pick(f, remote);
            li.append(b, el('small', r(f.v[0]) + ' kcal · ' + r(f.v[1]) + ' g / 100 g'));
            ul.append(li);
          }
        }

        function pick(f, remote) {
          picked = { food: f, remote };
          $('picked').textContent =
            f.name + (f.unit ? ' (' + f.unit + ' g per ' + f.unitName + ')' : '');
          $('pickbox').classList.add('on');
          const amounts = f.unit
            ? [1, 2, 3].map((n) => [n + ' ' + f.unitName + (n > 1 ? 's' : ''), n * f.unit])
            : [50, 100, 150, 200, 300].map((g) => [g + ' g', g]);
          $('quick').replaceChildren(
            ...amounts.map(([label, g]) => {
              const b = el('button', label);
              b.type = 'button';
              b.onclick = () => {
                $('grams').value = g;
                $('grams').focus();
              };
              return b;
            }),
          );
          $('grams').focus();
        }

        // ---- log -----------------------------------------------------------
        function addEntry(e) {
          const l = getLog();
          l.push(e);
          write(LOG, l);
          render();
        }

        $('add').onclick = () => {
          const g = Number($('grams').value);
          if (!picked) return say('Pick a food first.');
          if (!(g > 0) || g > 5000) return say('Enter an amount in grams, 1 to 5000.');
          const { food, remote } = picked;
          if (remote) {
            const c = getCache();
            if (!c.some((x) => x.name.toLowerCase() === food.name.toLowerCase())) {
              c.push(food);
              write(CACHE, c);
            }
          }
          const k = g / 100;
          addEntry({
            name: food.name,
            g,
            kcal: food.v[0] * k,
            prot: food.v[1] * k,
            carb: food.v[2] * k,
            fat: food.v[3] * k,
          });
          say('Added ' + food.name + '.');
          picked = null;
          $('picked').textContent = '';
          $('pickbox').classList.remove('on');
          $('grams').value = '';
          $('q').focus();
        };

        $('cadd').onclick = () => {
          const kcal = Number($('ckcal').value);
          const prot = Number($('cprot').value);
          const name = $('cname').value.trim().slice(0, 80) || 'other';
          if (!num(kcal, 20000) || !num(prot, 20000) || (!kcal && !prot)) {
            return say('Enter calories and/or protein as positive numbers.');
          }
          addEntry({ name, kcal, prot, carb: 0, fat: 0 });
          say('Added ' + name + '.');
          $('cname').value = $('ckcal').value = $('cprot').value = '';
        };

        // ---- search box ----------------------------------------------------
        $('q').oninput = () => {
          const q = $('q').value.trim().toLowerCase();
          say('');
          showResults(q ? allFoods().filter((f) => f.name.toLowerCase().includes(q)) : [], false);
        };
        const runSearch = () => {
          const q = $('q').value.trim();
          if (!q) return say('Type a food first.');
          const job = /^\d{8,14}$/.test(q) ? lookupBarcode(q) : searchUsda(q);
          job.catch(() => say('Network error. Try again.'));
        };
        $('search').onclick = runSearch;

        // Plain-words estimate from the Worker (open model on Workers AI). Only four
        // validated numbers come back; the name is what was typed. Tap to log it.
        async function estimate(text) {
          const token = read(TOKEN, '');
          if (!token) return say('Add the AI token in Settings.');
          say('Estimating...');
          const res = await fetch(API + '/estimate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
            body: JSON.stringify({ text }),
          });
          if (res.status === 401) return say('Wrong AI token.');
          if (res.status === 429) return say('AI limit reached. Try later.');
          if (!res.ok) return say('AI could not estimate that.');
          const d = await res.json();
          const e = {
            name: text.slice(0, 80),
            kcal: d.kcal,
            prot: d.protein,
            carb: d.carbs,
            fat: d.fat,
          };
          if (!validEntry(e)) return say('AI returned bad numbers.');
          say('Estimate (tap to log):');
          const ul = $('results');
          ul.replaceChildren();
          const li = el('li');
          const b = el('button', e.name, 'pick');
          b.type = 'button';
          b.onclick = () => {
            ul.replaceChildren();
            addEntry(e);
          };
          li.append(b, el('small', r(e.kcal) + ' kcal · ' + r(e.prot) + ' g'));
          ul.append(li);
        }
        $('ai').onclick = () => {
          const q = $('q').value.trim();
          if (!q) return say('Describe what you ate first, e.g. two eggs and toast.');
          estimate(q).catch(() => say('Network error. Try again.'));
        };
        // A block body: an arrow returning `false` from an on* handler cancels the keystroke.
        $('q').onkeydown = (e) => {
          if (e.key === 'Enter') runSearch();
        };

        // ---- render --------------------------------------------------------
        function bar(label, val, target, unit) {
          const box = el('div', undefined, 'bar' + (val >= target ? ' done' : ''));
          const t = el('div', undefined, 't');
          const left = target - val;
          t.append(
            el('b', label),
            el(
              'span',
              r(val) +
                ' / ' +
                target +
                unit +
                ' · ' +
                (left > 0 ? r(left) + unit + ' left' : 'done'),
            ),
          );
          const b = el('div', undefined, 'b');
          const i = el('i');
          i.style.width = Math.min(100, (val / target) * 100) + '%';
          b.append(i);
          box.append(t, b);
          return box;
        }

        function render() {
          const l = getLog();
          const s = l.reduce((a, e) => ({ kcal: a.kcal + e.kcal, prot: a.prot + e.prot }), {
            kcal: 0,
            prot: 0,
          });
          $('date').textContent = today.slice(5);
          $('bars').replaceChildren(
            bar('Protein', s.prot, T.prot, ' g'),
            bar('Calories', s.kcal, T.kcal, ''),
          );
          const ul = $('log');
          ul.replaceChildren();
          $('logempty').hidden = l.length > 0;
          l.forEach((e, i) => {
            const li = el('li');
            li.append(el('span', e.name + (e.g ? ' ' + r(e.g) + ' g' : '')));
            const right = el('span');
            right.append(el('small', r(e.kcal) + ' kcal · ' + r(e.prot) + ' g'));
            const x = el('button', '×', 'x');
            x.type = 'button';
            x.setAttribute('aria-label', 'Remove');
            x.onclick = () => {
              const cur = getLog();
              cur.splice(i, 1);
              write(LOG, cur);
              render();
            };
            right.append(x);
            li.append(right);
            ul.append(li);
          });
          recommend(T.prot - s.prot, T.kcal - s.kcal);
        }

        // Protein left, kcal left. For each lean protein source, size the portion
        // that closes the gap (capped to one sitting), drop what busts the
        // calorie budget, rank by protein per kcal.
        function recommend(pLeft, kLeft) {
          const box = $('recs');
          box.replaceChildren();
          if (pLeft <= 0) return box.append(el('p', 'Protein target hit. Nice work.', 'empty'));
          const out = allFoods()
            .filter((f) => f.v[0] > 0 && f.v[1] / f.v[0] >= 0.08 && !NOT_SUGGESTED.test(f.name))
            .map((f) => {
              const step = f.unit || 10;
              const cap = f.unit ? f.unit * 2 : 300;
              const g = Math.max(
                step,
                Math.round(Math.min((pLeft / f.v[1]) * 100, cap) / step) * step,
              );
              return {
                f,
                g,
                prot: (f.v[1] * g) / 100,
                kcal: (f.v[0] * g) / 100,
                ratio: f.v[1] / f.v[0],
              };
            })
            .filter((x) => x.kcal <= Math.max(kLeft, 0))
            .sort((a, b) => b.ratio - a.ratio)
            .slice(0, 5);
          if (!out.length) {
            return box.append(
              el(
                'p',
                r(pLeft) + ' g protein left but only ' + r(Math.max(kLeft, 0)) + ' kcal.',
                'empty',
              ),
            );
          }
          const ul = el('ul');
          for (const { f, g, prot, kcal } of out) {
            const li = el('li');
            const amount = f.unit
              ? g / f.unit + ' ' + f.unitName + (g / f.unit > 1 ? 's' : '')
              : g + ' g';
            const left = el('span');
            left.append(el('b', f.name), ' ' + amount);
            li.append(left, el('small', '+' + r(prot) + ' g · ' + r(kcal) + ' kcal'));
            li.onclick = () => {
              pick(f, false);
              $('grams').value = g;
            };
            ul.append(li);
          }
          box.append(ul);
        }

        // ---- settings ------------------------------------------------------
        $('ukey').value = read(KEY, '');
        $('tkey').value = read(TOKEN, '');
        if (!$('ukey').value || !$('tkey').value) $('settings').open = true;
        $('ksave').onclick = () => {
          write(KEY, $('ukey').value.trim());
          write(TOKEN, $('tkey').value.trim());
          say('Saved.');
        };

        $('export').onclick = () => {
          const logs = {};
          for (let i = 0; i < localStorage.length; i++) {
            const k = localStorage.key(i);
            if (/^food-log-\d{4}-\d{2}-\d{2}$/.test(k)) logs[k] = read(k, []);
          }
          const blob = new Blob([JSON.stringify({ cache: getCache(), logs }, null, 1)], {
            type: 'application/json',
          });
          const a = el('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'food-' + today + '.json';
          a.click();
          URL.revokeObjectURL(a.href);
        };

        // Import writes only the cache and dated logs, entry by validated entry.
        $('import').onclick = () => $('file').click();
        $('file').onchange = async () => {
          const file = $('file').files[0];
          $('file').value = '';
          if (!file || file.size > 2_000_000) return say('Pick a JSON file under 2 MB.');
          let data;
          try {
            data = JSON.parse(await file.text());
          } catch {
            return say('Not valid JSON.');
          }
          const cache = Array.isArray(data?.cache) ? data.cache.filter(validFood) : [];
          const merged = getCache();
          for (const f of cache) {
            if (!merged.some((x) => x.name.toLowerCase() === f.name.toLowerCase())) merged.push(f);
          }
          write(CACHE, merged);
          let days = 0;
          for (const [k, l] of Object.entries(data?.logs || {})) {
            if (!/^food-log-\d{4}-\d{2}-\d{2}$/.test(k) || !Array.isArray(l)) continue;
            write(k, l.filter(validEntry));
            days++;
          }
          say('Imported ' + cache.length + ' foods, ' + days + ' days.');
          render();
        };

        render();
      })();
    </script>
  </body>
</html>
